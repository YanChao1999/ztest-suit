#!/usr/bin/env bash
# Demo/CI mock west — used until a real `west update` tree is present.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="${ROOT}/twister-out"
REPORT="${OUT_DIR}/twister.json"

if [[ "${1:-}" != "twister" ]]; then
  echo "mock-west: unsupported command: $*" >&2
  echo "Only 'west twister' is simulated. Install real west + west update for full Zephyr." >&2
  exit 2
fi
shift

suite_filter=""
test_path="tests"
platform="native_sim"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -T) test_path="$2"; shift 2 ;;
    -s|--scenario) suite_filter="$2"; shift 2 ;;
    --platform|-p) platform="$2"; shift 2 ;;
    --list-tests)
      echo "math_suite.test_add"
      echo "math_suite.test_sub"
      echo "math_suite.test_mul"
      echo "string_suite.test_strlen"
      echo "string_suite.test_strcmp"
      echo "string_suite.test_fail_demo"
      exit 0
      ;;
    *) shift ;;
  esac
done

mkdir -p "${OUT_DIR}"

declare -a ALL_CASES=(
  "math_suite.test_add:pass"
  "math_suite.test_sub:pass"
  "math_suite.test_mul:pass"
  "string_suite.test_strlen:pass"
  "string_suite.test_strcmp:pass"
  "string_suite.test_fail_demo:fail"
)

# Map suite symbol → scenario id (from testcase.yaml) for -s filtering
matches_filter() {
  local suite="$1"
  local name="$2"
  local filter="$3"
  [[ -z "${filter}" ]] && return 0
  [[ "${suite}" == "${filter}" ]] && return 0
  [[ "${name}" == "${filter}"* ]] && return 0
  [[ "${filter}" == *"${suite}"* ]] && return 0
  # scenario ids e.g. ztest_suit.math / ztest_suit.string
  case "${filter}" in
    *math*) [[ "${suite}" == "math_suite" ]] && return 0 ;;
    *string*) [[ "${suite}" == "string_suite" ]] && return 0 ;;
  esac
  return 1
}

echo "INFO    - Mock twister (ztest-suit fixture demo)"
echo "INFO    - Using platform: ${platform}"
echo "INFO    - Test path: ${test_path}"
[[ -n "${suite_filter}" ]] && echo "INFO    - Suite/scenario filter: ${suite_filter}"
echo ""

json_cases="["
first=1
failed=0
ran=0

for entry in "${ALL_CASES[@]}"; do
  name="${entry%%:*}"
  expect="${entry##*:}"
  suite="${name%%.*}"
  case_name="${name#*.}"

  if ! matches_filter "${suite}" "${name}" "${suite_filter}"; then
    continue
  fi

  ran=$((ran + 1))
  echo "START - ${name}"
  sleep 0.08
  if [[ "${expect}" == "fail" ]]; then
    echo "FAIL - ${name}"
    status="failed"
    failed=$((failed + 1))
  else
    echo "PASS - ${case_name}"
    status="passed"
  fi
  if [[ ${first} -eq 0 ]]; then json_cases+=","; fi
  first=0
  json_cases+=$(printf '\n    {"identifier": "%s", "name": "%s", "status": "%s"}' "${name}" "${name}" "${status}")
done

json_cases+=$'\n  ]'
cat > "${REPORT}" <<EOF
{
  "testsuites": [
    {
      "name": "sample",
      "platform": "${platform}",
      "testcases": ${json_cases}
    }
  ]
}
EOF

echo ""
echo "INFO    - ${ran} test(s) executed, ${failed} failed"
echo "INFO    - Writing JSON report ${REPORT}"
[[ ${failed} -gt 0 ]] && exit 1
exit 0
